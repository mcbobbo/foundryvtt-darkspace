<form class="{{cssClass}} shadowdark flexcol" autocomplete="off">
    {{> items/item-header placeholder="Ship Class Name"}}

    <section class="sheet-body flexcol ds-item-body">
        <div class="ds-form-grid-4">
            <div class="form-group">
                <label>System Slots</label>
                <input name="system.systemSlots" type="number" value="{{system.systemSlots}}" min="0" />
            </div>
            <div class="form-group">
                <label>Feature Slots</label>
                <input name="system.featureSlots" type="number" value="{{system.featureSlots}}" min="0" />
            </div>
            <div class="form-group">
                <label>HP Die</label>
                <select name="system.hpDie">
                    <option value="d4" {{#if (eq system.hpDie "d4")}}selected{{/if}}>d4</option>
                    <option value="d6" {{#if (eq system.hpDie "d6")}}selected{{/if}}>d6</option>
                    <option value="d8" {{#if (eq system.hpDie "d8")}}selected{{/if}}>d8</option>
                </select>
            </div>
            <div class="form-group">
                <label>Talent Table UUID</label>
                <input name="system.talentTable" type="text" value="{{system.talentTable}}" placeholder="Compendium.darkspace..." />
            </div>
        </div>

        <div class="ds-form-grid-2">
            <div class="form-group">
                <label>Free Components</label>
                <ul class="ds-id-list">
                    {{#each system.freeComponents}}<li>{{this}}</li>{{/each}}
                </ul>
            </div>
            <div class="form-group">
                <label>Class Talents</label>
                <ul class="ds-id-list">
                    {{#each system.classTalents}}<li>{{this}}</li>{{/each}}
                </ul>
            </div>
        </div>

        <div class="form-group">
            <label>Description</label>
            {{editor system.description target="system.description" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
        </div>
    </section>
</form>
